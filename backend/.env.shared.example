# Общая база на Supabase. Скопировать в .env.shared и заполнить (в git не попадает).
# Брать из Supabase: Project Settings -> Database -> Connection string -> Session pooler.
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSL=true

DATABASE_ECHO=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT: у всех одинаковые секреты не нужны, но сгенерировать надо (минимум 32 символа).
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
