POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hackathon
POSTGRES_HOST=localhost
# Порт базы на компьютере; 5433, чтобы не конфликтовать с установленным локально PostgreSQL
POSTGRES_PORT=5433

DATABASE_ECHO=false

# Origin'ы фронта через запятую (нужно для cookie и CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Вход в панель (единственная учётная запись), пароль минимум 8 символов
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# JWT: два разных секрета, минимум 32 символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_64_hex_chars_000000
JWT_REFRESH_SECRET_KEY=change_me_generate_64_hex_chars_111111
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# JWT_REFRESH_GRACE_SECONDS=30

# true на деплое с HTTPS: cookie уходят только по защищённому соединению
COOKIE_SECURE=false

# Лимиты запросов с одного IP: вход и обновление токена
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=30/minute

# Исходный снимок для первичной загрузки в пустую базу.
# Локально по умолчанию берётся ../origin_data/data.json; в Docker снимок
# монтируется в /data:ro (см. docker-compose.yaml), тогда путь — /data/data.json.
# SOURCE_DATA_PATH=/data/data.json
# Грузить снимок при старте, если таблица accounts пуста
SEED_ON_STARTUP=true
# Интервал опроса версии сводки в SSE-потоке, секунды
SSE_POLL_INTERVAL_SECONDS=1

# Секрет для SessionMiddleware (authlib хранит в нём state/PKCE между
# редиректом на OIDC-провайдер и колбэком), минимум 32 символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_me_generate_64_hex_chars_222222

# Вход через Authentik (OIDC): выключен, пока не настроен Provider/Application
# в самой Authentik (см. backend/README.md) и не заполнены поля ниже.
OIDC_ENABLED=false
# Адрес вашего Authentik-приложения внутри сети compose, например:
# http://authentik-server:9000/application/o/<slug-приложения>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Куда Authentik вернёт пользователя после входа — должен совпадать с Redirect URI,
# указанным при создании Provider в Authentik
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# Куда редиректить обратно на фронт после успешного/неуспешного входа через OIDC
FRONTEND_URL=http://localhost:3000
# Authentik подставляет в свой .well-known-документ тот же хост, с которым к
# нему обратились за метаданными — бэкенд обращается как authentik-server
# (имя контейнера), а вот редирект браузера на экран логина должен идти на
# адрес, который резолвится у пользователя. Поэтому для самого экрана входа
# (authorization_endpoint) адрес задаём отдельно, localhost:
OIDC_AUTHORIZE_URL=http://localhost:9000/application/o/authorize/

# --- Ниже — секреты только для самого Authentik (см. docker-compose.yaml) ---
# Пароль собственной БД Authentik и Redis-хост заданы прямо в docker-compose.yaml
# (это внутренняя, не публикуемая наружу БД — не секрет). Два пункта ниже — настоящие
# секреты: ключ шифрования Authentik и пароль первого админа в его собственной панели.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
AUTHENTIK_SECRET_KEY=change_me_generate_64_hex_chars_333333
AUTHENTIK_BOOTSTRAP_EMAIL=admin@local.test
AUTHENTIK_BOOTSTRAP_PASSWORD=change_me12345
