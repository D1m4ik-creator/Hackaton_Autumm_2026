POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hackathon
POSTGRES_HOST=localhost
# Порт базы на компьютере; 5433, чтобы не конфликтовать с установленным локально PostgreSQL
POSTGRES_PORT=5433
POSTGRES_SSL=false

DATABASE_ECHO=false

# Origin'ы фронта через запятую (нужно для cookie и CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Вход в панель (единственная учётная запись), пароль минимум 8 символов
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# JWT: два разных секрета, минимум 32 символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_64_hex_chars_000000
JWT_REFRESH_SECRET_KEY=change_me_generate_64_hex_chars_111111
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# JWT_REFRESH_GRACE_SECONDS=30

# true на деплое с HTTPS: cookie уходят только по защищённому соединению
COOKIE_SECURE=false
