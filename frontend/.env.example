# Должен совпадать по хосту с тем, на чём реально открыт фронт (vite.config.ts
# биндит dev-сервер на 127.0.0.1, т.к. IPv6-loopback на части машин не слушается).
# localhost и 127.0.0.1 — разные "сайты" для браузера: cookie сессии с
# SameSite=Lax, поставленная с одного хоста, не уйдёт в XHR на другой —
# после /login сразу же будет 401 на /me ("Токен не найден").
VITE_API_URL=http://127.0.0.1:8000

# Grafana в dev идёт напрямую на порт 3001. В проде переменная не нужна:
# nginx отдаёт Grafana на том же домене под /grafana/ (same-origin по умолчанию).
VITE_GRAFANA_URL=http://127.0.0.1:3001
